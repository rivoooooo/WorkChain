  "views": {
    "public.company_proposal_status": {
      "columns": {
        "proposal_id": {
          "name": "proposal_id",
          "type": "varchar(255)",
          "primaryKey": false,
          "notNull": false
        },
        "company_id": {
          "name": "company_id",
          "type": "varchar(255)",
          "primaryKey": false,
          "notNull": false
        },
        "required_approvals": {
          "name": "required_approvals",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "approval_count": {
          "name": "approval_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "resolution": {
          "name": "resolution",
          "type": "varchar(30)",
          "primaryKey": false,
          "notNull": false
        },
        "resulting_version_id": {
          "name": "resulting_version_id",
          "type": "varchar(255)",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  select\n    p.id as proposal_id,\n    p.company_id,\n    p.required_approvals,\n    count(a.id)::integer as approval_count,\n    r.result as resolution,\n    r.resulting_version_id\n  from company_change_proposals p\n  left join company_change_approvals a on a.proposal_id = p.id\n  left join company_proposal_resolutions r on r.proposal_id = p.id\n  group by p.id, p.company_id, p.required_approvals, r.result, r.resulting_version_id\n",
      "name": "company_proposal_status",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.company_statistics": {
      "columns": {
        "company_id": {
          "name": "company_id",
          "type": "varchar(255)",
          "primaryKey": false,
          "notNull": false
        },
        "review_count": {
          "name": "review_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "avg_rating": {
          "name": "avg_rating",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_career": {
          "name": "avg_career",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_balance": {
          "name": "avg_balance",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_management": {
          "name": "avg_management",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_compensation": {
          "name": "avg_compensation",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_culture": {
          "name": "avg_culture",
          "type": "numeric(4, 2)",
          "primaryKey": false,
          "notNull": false
        },
        "avg_salary": {
          "name": "avg_salary",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "avg_bonus": {
          "name": "avg_bonus",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  select\n    company_id,\n    count(*)::integer as review_count,\n    round(avg((rating_career + rating_balance + rating_management + rating_compensation + rating_culture)::numeric / 5), 2) as avg_rating,\n    round(avg(rating_career)::numeric, 2) as avg_career,\n    round(avg(rating_balance)::numeric, 2) as avg_balance,\n    round(avg(rating_management)::numeric, 2) as avg_management,\n    round(avg(rating_compensation)::numeric, 2) as avg_compensation,\n    round(avg(rating_culture)::numeric, 2) as avg_culture,\n    coalesce(round(avg(salary) filter (where salary > 0)), 0)::integer as avg_salary,\n    coalesce(round(avg(bonus) filter (where bonus > 0)), 0)::integer as avg_bonus\n  from reviews\n  group by company_id\n",
      "name": "company_statistics",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
