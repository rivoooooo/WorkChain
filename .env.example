# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase API Settings (Supports Next.js Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_[YOUR_PUBLISHABLE_KEY]"

# Database connections must use separate credentials.
# DATABASE_OWNER_URL is deployment-only and is never read by the running app.
DATABASE_OWNER_URL="postgresql://[OWNER]:[PASSWORD]@[HOST]:5432/postgres"
# APP_DATABASE_URL should belong to a role that can only SELECT and INSERT.
APP_DATABASE_URL="postgresql://[APP_WRITER]:[PASSWORD]@[HOST]:5432/postgres"

# Public company governance
COMPANY_CHANGE_APPROVAL_THRESHOLD="50"
ANONYMOUS_VOTER_SECRET="[32+ random bytes]"
IP_RATE_LIMIT_SECRET="[32+ random bytes]"

# Human verification. Leave disabled until a provider is configured.
HUMAN_VERIFICATION_PROVIDER="disabled"
HUMAN_VERIFICATION_SITE_KEY=""
HUMAN_VERIFICATION_SECRET_KEY=""
HUMAN_VERIFICATION_VERIFY_URL=""
# Use a header that your hosting platform overwrites (for example cf-connecting-ip).
TRUSTED_IP_HEADER=""

# Optional overrides for public-write limits.
COMPANY_CREATE_RATE_LIMIT_MAX="3"
COMPANY_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"
COMPANY_SUPPLEMENT_RATE_LIMIT_MAX="10"
COMPANY_SUPPLEMENT_RATE_LIMIT_WINDOW_SECONDS="3600"
PROPOSAL_CREATE_RATE_LIMIT_MAX="5"
PROPOSAL_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"
PROPOSAL_APPROVE_RATE_LIMIT_MAX="10"
PROPOSAL_APPROVE_RATE_LIMIT_WINDOW_SECONDS="600"
REVIEW_CREATE_RATE_LIMIT_MAX="5"
REVIEW_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"

# Optional distributed KV rate-limit adapter.
SUPABASE_KV_URL=""
SUPABASE_KV_TOKEN=""
KV_NAMESPACE="work-chain:development"

# Public data snapshots in Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=""
PUBLIC_DATA_SNAPSHOT_BUCKET="public-data-snapshots"
SNAPSHOT_RETENTION_DAYS="7"
CRON_SECRET="[32+ random bytes]"

# Environment guards
APP_ENV="development"
PRODUCTION_SUPABASE_PROJECT_REF=""
CONFIRM_PRODUCTION_PUSH=""

# Optional read-only database comparison tool.
DB1_NAME=""
DB1_SUPABASE_URL=""
DB1_SUPABASE_PUBLISHABLE_KEY=""
DB1_DATABASE_URL=""
DB2_NAME=""
DB2_SUPABASE_URL=""
DB2_SUPABASE_PUBLISHABLE_KEY=""
DB2_DATABASE_URL=""
