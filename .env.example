# Required in the Vercel production runtime.
APP_ENV="production"
APP_DATABASE_URL="postgresql://[APP_WRITER]:[PASSWORD]@[POOLER_HOST]:6543/postgres"
# Public browser reads use the Supabase Data API and remain protected by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[SUPABASE_PUBLISHABLE_KEY]"
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
COMPANY_CHANGE_APPROVAL_THRESHOLD="50"
ANONYMOUS_VOTER_SECRET="[32+ random bytes]"
IP_RATE_LIMIT_SECRET="[32+ random bytes]"

# Turnstile is mandatory when APP_ENV=production.
HUMAN_VERIFICATION_PROVIDER="turnstile"
NEXT_PUBLIC_HUMAN_VERIFICATION_PROVIDER="turnstile"
NEXT_PUBLIC_HUMAN_VERIFICATION_SITE_KEY="[TURNSTILE_SITE_KEY]"
HUMAN_VERIFICATION_SECRET_KEY="[TURNSTILE_SECRET_KEY]"
# Optional: the code already uses this URL by default.
HUMAN_VERIFICATION_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
HUMAN_VERIFICATION_ALLOWED_HOSTNAMES="example.com,www.example.com"
# Vercel overwrites this header with the client IP.
TRUSTED_IP_HEADER="x-vercel-forwarded-for"

# A distributed limiter is mandatory when APP_ENV=production.
SUPABASE_KV_URL="https://[YOUR-KV-SERVICE]"
SUPABASE_KV_TOKEN="[KV_SERVICE_TOKEN]"
KV_NAMESPACE="work-chain:production"

# Optional overrides for public-write limits.
COMPANY_CREATE_RATE_LIMIT_MAX="3"
COMPANY_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"
COMPANY_SUPPLEMENT_RATE_LIMIT_MAX="10"
COMPANY_SUPPLEMENT_RATE_LIMIT_WINDOW_SECONDS="3600"
PROPOSAL_CREATE_RATE_LIMIT_MAX="5"
PROPOSAL_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"
PROPOSAL_APPROVE_RATE_LIMIT_MAX="10"
PROPOSAL_APPROVE_RATE_LIMIT_WINDOW_SECONDS="600"
REVIEW_CREATE_RATE_LIMIT_MAX="5"
REVIEW_CREATE_RATE_LIMIT_WINDOW_SECONDS="3600"

# Optional public snapshots in Supabase Storage.
# Keep the snapshot-specific values unset if snapshots are disabled.
SUPABASE_SERVICE_ROLE_KEY=""
PUBLIC_DATA_SNAPSHOT_BUCKET="public-data-snapshots"
SNAPSHOT_RETENTION_DAYS="7"
CRON_SECRET="[32+ random bytes]"

# Optional Gemini analysis. Without it, the API returns a local heuristic report.
GEMINI_API_KEY=""

# Deployment-only schema administration. Do not add DATABASE_OWNER_URL to the
# Vercel runtime; use it locally or in a protected migration job.
DATABASE_OWNER_URL="postgresql://[OWNER]:[PASSWORD]@[HOST]:5432/postgres"
PRODUCTION_SUPABASE_PROJECT_REF=""
CONFIRM_PRODUCTION_PUSH="push-production-schema"

# Optional read-only database comparison tool.
DB1_NAME=""
DB1_SUPABASE_URL=""
DB1_SUPABASE_PUBLISHABLE_KEY=""
DB1_DATABASE_URL=""
DB2_NAME=""
DB2_SUPABASE_URL=""
DB2_SUPABASE_PUBLISHABLE_KEY=""
DB2_DATABASE_URL=""
